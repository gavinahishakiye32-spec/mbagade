# ---- Core (required in production) ----
MONGODB_URI=mongodb://127.0.0.1:27017/buybuy
# 32+ random bytes, e.g. `openssl rand -hex 32`. Required in production; dev fallback used otherwise.
AUTH_SECRET=
# Public base URL used for OAuth redirects, email links and referral invite URLs.
APP_URL=http://localhost:3000
# Initial access mode (addendum #2): public | early_access | invite_only | private.
# Runtime-editable afterwards from Admin → Platform (stored in the platform config).
ACCESS_MODE=public

# ---- OAuth (optional — buttons fall back to /login?error=<provider>_not_configured) ----
# Google Cloud Console → OAuth client (Web). Redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → Facebook Login. Redirect URI: {APP_URL}/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Payments (optional — defaults to the built-in dev provider) ----
# auto | stripe | dev. "auto" uses Stripe when STRIPE_SECRET_KEY is set.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email / SMTP (optional — emails are logged to console when unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BuyBuy <no-reply@yourdomain.com>"

# ---- AI (optional — caption/description helpers and AI moderation stay off when unset) ----
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq, local vLLM…).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MODERATION_MODEL=gpt-4o-mini

# ---- Media storage (optional — defaults to local disk under .data/uploads) ----
# local | s3
MEDIA_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN/base URL serving the bucket (media URLs point here when set).
S3_PUBLIC_BASE_URL=

# ---- WebRTC calls (optional — needed for P2P calls behind symmetric NATs) ----
# Comma-separated, e.g. turn:turn.example.com:3478?transport=udp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Bot protection (optional) ----
TURNSTILE_SECRET=
